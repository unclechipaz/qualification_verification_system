# Copy to docker/production.env, set real values and keep the copy out of Git.
QVS_IMAGE=ghcr.io/unclechipaz/qualification_verification_system@sha256:REPLACE_WITH_PUBLISHED_DIGEST
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=qvs.example.org
DB_NAME=msu_qvs_db
DB_USER=msu_user
DB_PASSWORD=
QVS_BIND_ADDRESS=127.0.0.1
QVS_PORT=8000
DJANGO_SSL_REDIRECT=true
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_CSRF_ORIGINS=https://qvs.example.org
DJANGO_CORS_ORIGINS=
